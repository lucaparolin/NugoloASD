@model NugoloASD.Web.ViewModels.Soci.SocioDetailsViewModel
@{
    ViewData["Title"] = $"{Model.NomeCompleto} - Dettagli";
}

<div class="page-header mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Soci</a></li>
            <li class="breadcrumb-item active" aria-current="page">Dettagli</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="page-title">@Model.NomeCompleto</h1>
            <p class="page-subtitle mb-0">
                <span class="badge bg-@(Model.Attivo ? "success" : "secondary") me-2">
                    @(Model.Attivo ? "Attivo" : "Non Attivo")
                </span>
                <span class="badge bg-secondary-subtle text-secondary">@Model.TipoSocio</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Edit", new { id = Model.SocioId })" class="btn btn-primary">
                <i class="bi bi-pencil me-2"></i>Modifica
            </a>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Torna alla Lista
            </a>
        </div>
    </div>
</div>

<!-- Avviso Certificato Scaduto -->
@if (!Model.CertificatoMedicoValido)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
        <div>
            <strong>Certificato Medico Scaduto!</strong><br />
            @if (Model.DataScadenzaCertificatoMedico.HasValue)
            {
                <small>Scaduto il @Model.DataScadenzaCertificatoMedico.Value.ToString("dd/MM/yyyy")</small>
            }
            else
            {
                <small>Nessun certificato presente</small>
            }
        </div>
    </div>
}
else if (Model.GiorniScadenzaCertificato.HasValue && Model.GiorniScadenzaCertificato.Value <= 30)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-circle-fill fs-4 me-3"></i>
        <div>
            <strong>Certificato in Scadenza!</strong><br />
            <small>Mancano @Model.GiorniScadenzaCertificato giorni alla scadenza (@Model.DataScadenzaCertificatoMedico.Value.ToString("dd/MM/yyyy"))</small>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Colonna Sinistra -->
    <div class="col-lg-8">
        <!-- Dati Anagrafici -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-person-vcard me-2"></i>Dati Anagrafici</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Nome</label>
                        <p class="fw-semibold mb-0">@Model.Nome</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Cognome</label>
                        <p class="fw-semibold mb-0">@Model.Cognome</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Codice Fiscale</label>
                        <p class="fw-semibold mb-0 font-monospace">@Model.CodiceFiscale</p>
                    </div>
                    <div class="col-md-3">
                        <label class="text-muted small">Data di Nascita</label>
                        <p class="fw-semibold mb-0">@Model.DataNascita.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-3">
                        <label class="text-muted small">Età</label>
                        <p class="fw-semibold mb-0">@Model.Eta anni</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.LuogoNascita))
                    {
                        <div class="col-md-6">
                            <label class="text-muted small">Luogo di Nascita</label>
                            <p class="fw-semibold mb-0">@Model.LuogoNascita</p>
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="text-muted small">Sesso</label>
                        <p class="fw-semibold mb-0">@(Model.Sesso == "M" ? "Maschio" : "Femmina")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contatti e Residenza -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-envelope me-2"></i>Contatti e Residenza</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div class="col-md-12">
                            <label class="text-muted small">Email</label>
                            <p class="fw-semibold mb-0">
                                <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                            </p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Telefono))
                    {
                        <div class="col-md-6">
                            <label class="text-muted small">Telefono</label>
                            <p class="fw-semibold mb-0">
                                <a href="tel:@Model.Telefono" class="text-decoration-none">@Model.Telefono</a>
                            </p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Cellulare))
                    {
                        <div class="col-md-6">
                            <label class="text-muted small">Cellulare</label>
                            <p class="fw-semibold mb-0">
                                <a href="tel:@Model.Cellulare" class="text-decoration-none">@Model.Cellulare</a>
                            </p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Indirizzo))
                    {
                        <div class="col-md-12">
                            <label class="text-muted small">Indirizzo</label>
                            <p class="fw-semibold mb-0">
                                @Model.Indirizzo
                                @if (!string.IsNullOrEmpty(Model.Citta))
                                {
                                    <br />@Model.CAP @Model.Citta (@Model.Provincia)
                                }
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Dati Genitore (se minorenne) -->
        @if (Model.Minorenne && !string.IsNullOrEmpty(Model.NomeGenitore))
        {
            <div class="card border-0 shadow-sm mb-4 border-warning">
                <div class="card-header bg-warning bg-opacity-10">
                    <h5 class="mb-0 fw-semibold text-warning">
                        <i class="bi bi-person-check me-2"></i>Dati Genitore/Tutore
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Nome Genitore</label>
                            <p class="fw-semibold mb-0">@Model.NomeGenitore @Model.CognomeGenitore</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.TelefonoGenitore))
                        {
                            <div class="col-md-6">
                                <label class="text-muted small">Telefono Genitore</label>
                                <p class="fw-semibold mb-0">
                                    <a href="tel:@Model.TelefonoGenitore" class="text-decoration-none">@Model.TelefonoGenitore</a>
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Note -->
        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-sticky me-2"></i>Note</h5>
                </div>
                <div class="card-body">
                    <p class="mb-0">@Model.Note</p>
                </div>
            </div>
        }
    </div>

    <!-- Colonna Destra -->
    <div class="col-lg-4">
        <!-- Certificato Medico -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-heart-pulse me-2"></i>Certificato Medico</h5>
            </div>
            <div class="card-body">
                @if (Model.DataScadenzaCertificatoMedico.HasValue)
                {
                    <div class="mb-3">
                        <label class="text-muted small">Stato</label>
                        <p class="mb-0">
                            @if (Model.CertificatoMedicoValido)
                            {
                                <span class="badge bg-success">Valido</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Scaduto</span>
                            }
                        </p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small">Data Scadenza</label>
                        <p class="fw-semibold mb-0">@Model.DataScadenzaCertificatoMedico.Value.ToString("dd/MM/yyyy")</p>
                    </div>
                    @if (Model.GiorniScadenzaCertificato.HasValue)
                    {
                        <div>
                            <label class="text-muted small">Giorni alla Scadenza</label>
                            <p class="fw-semibold mb-0">
                                @if (Model.GiorniScadenzaCertificato.Value < 0)
                                {
                                    <span class="text-danger">Scaduto da @Math.Abs(Model.GiorniScadenzaCertificato.Value) giorni</span>
                                }
                                else
                                {
                                    <span class="@(Model.GiorniScadenzaCertificato.Value <= 30 ? "text-warning" : "text-success")">
                                        @Model.GiorniScadenzaCertificato giorni
                                    </span>
                                }
                            </p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-3">
                        <i class="bi bi-file-earmark-medical fs-1 mb-2 d-block"></i>
                        <p class="mb-0">Nessun certificato presente</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.NoteMediche))
                {
                    <div class="mt-3 pt-3 border-top">
                        <label class="text-muted small">Note Mediche</label>
                        <p class="mb-0 small">@Model.NoteMediche</p>
                    </div>
                }
            </div>
        </div>

        <!-- Privacy -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-shield-check me-2"></i>Privacy</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-@(Model.ConsensoPrivacy ? "check-circle-fill text-success" : "x-circle-fill text-danger")"></i>
                        <span>Consenso Privacy</span>
                    </div>
                    @if (Model.DataConsensoPrivacy.HasValue)
                    {
                        <small class="text-muted">Dato il @Model.DataConsensoPrivacy.Value.ToString("dd/MM/yyyy")</small>
                    }
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-@(Model.ConsensoMarketing ? "check-circle-fill text-success" : "x-circle-fill text-muted")"></i>
                        <span>Consenso Marketing</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Info Sistema -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2"></i>Informazioni Sistema</h5>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="text-muted small">Creato il</label>
                    <p class="mb-0 small">@Model.DataInserimento.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                @if (Model.DataModifica.HasValue)
                {
                    <div>
                        <label class="text-muted small">Ultima Modifica</label>
                        <p class="mb-0 small">@Model.DataModifica.Value.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
